<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette -->

    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#16305E" Offset="0" />
        <GradientStop Color="#2A4E8C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBorder" Color="#3B82F6" />
    <SolidColorBrush x:Key="TitleForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleAccentForeground" Color="#8CC4FF" />

    <SolidColorBrush x:Key="WindowBackground" Color="#EEF2F7" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ListHeaderBackground" Color="#F1F5F9" />

    <SolidColorBrush x:Key="Foreground" Color="#0F172A" />
    <SolidColorBrush x:Key="SecondaryForeground" Color="#475569" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#A0AABA" />
    <SolidColorBrush x:Key="AccentForeground" Color="#1D5FD1" />
    <SolidColorBrush x:Key="ModifiedForeground" Color="#C25E00" />
    <SolidColorBrush x:Key="ErrorForeground" Color="#C62828" />

    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder" Color="#B6C2D2" />
    <SolidColorBrush x:Key="InputBorderFocus" Color="#2563EB" />

    <SolidColorBrush x:Key="ButtonBackground" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#E6ECF4" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#D5DEEA" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#B6C2D2" />

    <SolidColorBrush x:Key="AccentBackground" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBackground" Color="#3B76F0" />
    <SolidColorBrush x:Key="OnAccentForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ApplyBackground" Color="#F5A524" />
    <SolidColorBrush x:Key="ApplyHoverBackground" Color="#FFB940" />
    <SolidColorBrush x:Key="ApplyForeground" Color="#13203A" />

    <SolidColorBrush x:Key="RowAltBackground" Color="#F5F8FC" />
    <SolidColorBrush x:Key="RowHoverBackground" Color="#E8EFF8" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#CFE0FB" />

    <SolidColorBrush x:Key="ScrollThumb" Color="#C2CCD9" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A3B0C2" />

</ResourceDictionary>
