<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette (default) -->

    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0D1830" Offset="0" />
        <GradientStop Color="#1B2C50" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBorder" Color="#3B82F6" />
    <SolidColorBrush x:Key="TitleForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleAccentForeground" Color="#5AA9FF" />

    <SolidColorBrush x:Key="WindowBackground" Color="#1B2436" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1E293B" />
    <SolidColorBrush x:Key="PanelBorder" Color="#2F3C54" />
    <SolidColorBrush x:Key="ListHeaderBackground" Color="#172133" />

    <SolidColorBrush x:Key="Foreground" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SecondaryForeground" Color="#94A3B8" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#5B6678" />
    <SolidColorBrush x:Key="AccentForeground" Color="#4DA3FF" />
    <SolidColorBrush x:Key="ModifiedForeground" Color="#F5A623" />
    <SolidColorBrush x:Key="ErrorForeground" Color="#FF6B6B" />

    <SolidColorBrush x:Key="InputBackground" Color="#0F172A" />
    <SolidColorBrush x:Key="InputBorder" Color="#334155" />
    <SolidColorBrush x:Key="InputBorderFocus" Color="#3B82F6" />

    <SolidColorBrush x:Key="ButtonBackground" Color="#1E2A40" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#283752" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#334563" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#3A4A66" />

    <SolidColorBrush x:Key="AccentBackground" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBackground" Color="#5A96F8" />
    <SolidColorBrush x:Key="OnAccentForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ApplyBackground" Color="#F5A524" />
    <SolidColorBrush x:Key="ApplyHoverBackground" Color="#FFB940" />
    <SolidColorBrush x:Key="ApplyForeground" Color="#13203A" />

    <SolidColorBrush x:Key="RowAltBackground" Color="#212D42" />
    <SolidColorBrush x:Key="RowHoverBackground" Color="#27354E" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#2B4C80" />

    <SolidColorBrush x:Key="ScrollThumb" Color="#3F4D66" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#56667F" />

</ResourceDictionary>
