<Window x:Class="BmsConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falcon BMS Config Editor"
        Width="1600" Height="1000" MinWidth="1000" MinHeight="600"
        Icon="Config.ico"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Foreground}"
        UseLayoutRounding="True"
        AllowDrop="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="NavigationCommands.Refresh" />
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="NavigationCommands.Refresh" Executed="OnReloadCommand" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenFolderCommand" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindCommand" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="0,0,0,2" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" x:Name="LogoImage" Width="68" Height="68" Margin="0,0,18,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TitleForeground}">FALCON BMS</TextBlock>
                        <TextBlock FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TitleAccentForeground}" Margin="10,0,0,0">CONFIG</TextBlock>
                        <TextBlock x:Name="VersionText" FontSize="15" Foreground="#B0BCD0" Margin="14,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Grid>
                            <ComboBox x:Name="InstallCombo" MinWidth="280" MaxWidth="560" SelectionChanged="OnInstallChanged"
                                      ToolTip="Falcon BMS installations found on this computer" />
                            <TextBlock x:Name="InstallPlaceholder" Text="Select a game installation..." IsHitTestVisible="False"
                                       Margin="13,0,32,0" VerticalAlignment="Center" Foreground="{DynamicResource Foreground}" />
                        </Grid>
                        <Button Content="Open Folder" Margin="12,0,0,0" Click="OnOpenFolderClick"
                                ToolTip="Locate the folder containing your Falcon BMS cfg files (Ctrl+O)" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SegmentContainer}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystem" Style="{StaticResource SegmentRadio}" GroupName="Theme" Content="System" Checked="OnThemeChecked" />
                            <RadioButton x:Name="ThemeLight" Style="{StaticResource SegmentRadio}" GroupName="Theme" Content="Light" Checked="OnThemeChecked" />
                            <RadioButton x:Name="ThemeDark" Style="{StaticResource SegmentRadio}" GroupName="Theme" Content="Dark" Checked="OnThemeChecked" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="FullScreenButton" Content="Full Screen" Margin="16,0,0,0" Click="OnFullScreenClick"
                            ToolTip="Toggle full screen (F11)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Filter bar ===== -->
        <Grid Grid.Row="1" Margin="24,14,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Search" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="SearchBox" Width="320" TextChanged="OnFilterChanged" Margin="0,0,24,0"
                         ToolTip="Search param names, descriptions and categories (Ctrl+F)" />
                <TextBlock Text="Category" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="CategoryCombo" Width="300" SelectionChanged="OnFilterChanged" Margin="0,0,24,0" MaxDropDownHeight="600" />
                <CheckBox x:Name="ModifiedOnlyCheck" Content="Modified only" VerticalAlignment="Center" Margin="0,0,24,0"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                          ToolTip="Show only the params overridden in Falcon BMS User.cfg (or VR.cfg)" />
                <CheckBox x:Name="IncludeVrCheck" Content="Include VR overrides in view" VerticalAlignment="Center"
                          Checked="OnIncludeVrChanged" Unchecked="OnIncludeVrChanged"
                          ToolTip="Show the values that apply when the game is launched in VR mode" />
            </WrapPanel>
            <Button Grid.Column="1" Content="Reload  (F5)" Click="OnReloadClick" VerticalAlignment="Center"
                    ToolTip="Re-read the cfg files from disk" />
        </Grid>

        <!-- ===== Master / detail ===== -->
        <Grid Grid.Row="2" Margin="24,4,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Master list -->
            <Grid Grid.Column="0">
                <ListView x:Name="ParamList" SelectionMode="Single" SelectionChanged="OnParamSelected"
                          GridViewColumnHeader.Click="OnColumnHeaderClick">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="PARAMETER" Width="380">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="VALUE" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Value" Text="{Binding Value}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource ModifiedForeground}" />
                                                <Setter TargetName="Value" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="DEFAULT" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Default}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryForeground}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SOURCE" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SourceText}" Margin="8,0,0,0" Foreground="{DynamicResource SecondaryForeground}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="CATEGORY" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Category}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryForeground}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel x:Name="ListEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620" Margin="40,60,40,0">
                    <TextBlock x:Name="ListEmptyText" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="15"
                               Text="Select your Falcon BMS installation in the drop-down above, or click &quot;Open Folder&quot; (Ctrl+O) and choose the folder that contains your Falcon BMS config files." />
                    <TextBlock x:Name="ListEmptyHint" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="15"
                               Margin="0,18,0,0" Text="You can also drag a .cfg file onto this window." />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="16" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" />

            <!-- Detail pane -->
            <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="DetailEmptyState" Text="Select a setting in the table to see its description and change its value."
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Margin="40" FontSize="15" Style="{StaticResource SecondaryText}" />

                    <ScrollViewer x:Name="DetailPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,24,24,24">
                        <StackPanel>
                            <TextBlock x:Name="DetailName" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailType" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailNotice" Foreground="{DynamicResource ModifiedForeground}" Margin="0,8,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}" />
                            <TextBox x:Name="DetailDescription" IsReadOnly="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="320"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="14,12" />

                            <TextBlock Text="VALUES" Style="{StaticResource SectionLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Default:" Margin="0,2,10,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailDefault" FontWeight="SemiBold" Margin="0,2" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="Current:" Margin="0,2,10,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2" TextWrapping="Wrap">
                                    <Run x:Name="DetailCurrent" FontWeight="SemiBold" /><Run Text="    " /><Run x:Name="DetailCurrentSource" Foreground="{DynamicResource SecondaryForeground}" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="User.cfg:" Margin="0,2,10,2" Style="{StaticResource SecondaryText}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailUser" Margin="0,2" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="VR.cfg:" Margin="0,2,10,2" Style="{StaticResource SecondaryText}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailVr" Margin="0,2" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Text="NEW VALUE" Style="{StaticResource SectionLabel}" />

                            <!-- Boolean editor -->
                            <Border x:Name="BoolEditor" Style="{StaticResource SegmentContainer}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BoolOn" Style="{StaticResource SegmentRadio}" GroupName="BoolValue" Content="ON"
                                                 MinWidth="90" Click="OnBoolClick" />
                                    <RadioButton x:Name="BoolOff" Style="{StaticResource SegmentRadio}" GroupName="BoolValue" Content="Off"
                                                 MinWidth="90" Click="OnBoolClick" />
                                </StackPanel>
                            </Border>

                            <!-- Enum editor -->
                            <ComboBox x:Name="EnumEditor" HorizontalAlignment="Stretch" SelectionChanged="OnEnumChanged" />

                            <!-- Choice editor: buttons for a small set of discrete numbers (Values: [8,9,10] or Range: [a-b, by c]) -->
                            <WrapPanel x:Name="ChoiceEditor" />

                            <!-- Text editor (int / float / string) -->
                            <TextBox x:Name="TextEditor" KeyDown="OnTextEditorKeyDown" TextChanged="OnTextEditorChanged" MinHeight="40"
                                     ToolTip="Press Enter to apply" />

                            <TextBlock x:Name="EditorError" Foreground="{DynamicResource ErrorForeground}" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="SAVE TO" Style="{StaticResource SectionLabel}" />
                            <WrapPanel>
                                <CheckBox x:Name="SaveToUser" Content="Falcon BMS User.cfg" Margin="0,4,28,4" IsChecked="True" Click="OnSaveToChanged" />
                                <CheckBox x:Name="SaveToVr" Content="Falcon BMS VR.cfg" Margin="0,4,28,4" Click="OnSaveToChanged" />
                                <CheckBox x:Name="SaveToBms" Content="Falcon BMS.cfg" Margin="0,4,28,4" IsEnabled="False" Click="OnSaveToChanged" />
                            </WrapPanel>

                            <WrapPanel Margin="0,18,0,0">
                                <Button x:Name="ApplyButton" Style="{StaticResource ApplyButton}" Content="Apply &amp; Save" MinWidth="150"
                                        Margin="0,0,12,8" Click="OnApplyClick" />
                                <Button x:Name="FillDefaultButton" Content="Fill with default" MinWidth="150" Margin="0,0,12,8" Click="OnFillDefaultClick"
                                        ToolTip="Put the default value (from Falcon BMS.cfg) into the editor" />
                                <Button x:Name="RevertButton" Content="Remove override" MinWidth="150" Margin="0,0,12,8" Click="OnRevertClick"
                                        ToolTip="Remove this param from the selected file(s), reverting it to the default. Lines with a trailing comment are commented out, rather than deleted." />
                            </WrapPanel>

                            <TextBlock x:Name="SaveFeedback" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Grid Grid.Row="3" Margin="26,8,26,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                       Text="Select your installation above, or press Open Folder." />
            <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource SecondaryText}" Margin="20,0,0,0" />
        </Grid>
    </Grid>
</Window>
